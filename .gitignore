.aider*
# ホーム直下等に現れる .claude/ は追跡しない。
# ただしリポジトリ内の stow パッケージ config/claude/.claude/ は例外(下で再許可)
.claude/
!config/claude/.claude/
!config/claude/.claude/**

# Local/private git configuration (email, name, etc)
config/git/.gitconfig.local

# Claude skills: 実行時キャッシュと生成物 (セッション履歴を含むため公開しない)
config/claude/.claude/skills/**/.cache.json
config/claude/.claude/skills/**/__pycache__/
config/claude/.claude/skills/**/*.pyc
config/claude/.claude/skills/*-workspace/

# 秘密を入れる慣習のファイル。追跡すべきテンプレートは *.example にする。
# .gitleaks.toml の sensitive-file ルールと同じ対象を並べる(片方を直したら他方も直す)。
.env
.env.*
!*.example
.env_file
.envrc
.secrets/
*.pem
*.key
*.p12
*.pfx
*.p8
*.ppk
*.kdbx
*.tfvars
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
!*.pub
.credentials*
credentials
.git-credentials
cloudflare.ini
.netrc
.pgpass

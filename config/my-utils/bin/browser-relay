#!/usr/bin/env python3
"""Open URLs sent by open-on-windows (remote hosts) in the Windows browser.

Runs on WSL, listening on localhost only; remote hosts reach it through an
ssh RemoteForward. One URL per connection, answered with "ok" or "ng".
Exits quietly if another instance already holds the port.
"""
import os
import re
import socketserver
import subprocess

PORT = int(os.environ.get("BROWSER_RELAY_PORT", "47123"))
URL = re.compile(r"https?://[^\s\x00-\x1f\x7f]+")


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        url = self.rfile.readline(8192).decode("utf-8", "replace").strip()
        if not URL.fullmatch(url):
            self.wfile.write(b"ng\n")
            return
        # explorer.exe hands the URL to the default browser; its exit code is
        # meaningless, so don't wait on it.
        subprocess.Popen(["explorer.exe", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.wfile.write(b"ok\n")


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


if __name__ == "__main__":
    try:
        server = Server(("127.0.0.1", PORT), Handler)
    except OSError:
        raise SystemExit(0)
    server.serve_forever()

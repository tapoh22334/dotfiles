# nuc11: claude.ai/code から ~/working にセッションを起動できるよう常駐させる
# 設置: ~/.config/systemd/user/ にリンクし systemctl --user enable --now
[Unit]
Description=Claude Code Remote Control (~/working)
After=network-online.target

[Service]
WorkingDirectory=%h/working
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude remote-control --name nuc11 --permission-mode auto
# TUI の再描画が毎秒ジャーナルに流れ込むので捨てる。エラーは stderr に残る
StandardOutput=null
Restart=always
RestartSec=30

[Install]
WantedBy=default.target

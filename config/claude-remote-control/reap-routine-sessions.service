# claude-remote-control が routine ごとに残す子プロセスを片付ける(reap-routine-sessions.sh 参照)
# 設置: ~/.config/systemd/user/ に .service と .timer をリンクし、
#       systemctl --user enable --now reap-routine-sessions.timer
[Unit]
Description=Reap finished routine sessions left by claude remote-control

[Service]
Type=oneshot
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.dotfiles/config/claude-remote-control/reap-routine-sessions.sh

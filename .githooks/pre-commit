#!/usr/bin/env bash
# 公開 repo なので、秘密情報を含む変更をコミットの時点で止める。
# 誤検知で止まったときは .gitleaks.toml の allowlist を直す(--no-verify で黙らせない)。
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks が見つからないためコミットを止めた(brew install gitleaks)" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml .
